<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mega Casino</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');
        
        :root {
            --bg: #0b0f19; --sidebar: #111827; --card: #1f2937; --text: #f3f4f6;
            --muted: #9ca3af; --primary: #3b82f6; --green: #10b981; --red: #ef4444; --gold: #f59e0b;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        body { background: var(--bg); color: var(--text); display: flex; height: 100vh; overflow: hidden; }

        .sidebar { width: 250px; background: var(--sidebar); border-right: 1px solid #374151; display: flex; flex-direction: column; }
        .logo { padding: 20px; font-size: 24px; font-weight: 800; color: var(--gold); border-bottom: 1px solid #374151; text-align: center; }
        .menu { padding: 20px 10px; flex: 1; }
        .menu-item { display: flex; align-items: center; gap: 15px; padding: 15px; color: var(--muted); font-weight: 600; border-radius: 10px; cursor: pointer; margin-bottom: 5px; }
        .menu-item:hover, .menu-item.active { background: #374151; color: white; }
        
        .user-panel { padding: 20px; border-top: 1px solid #374151; background: #111827; }
        .user-balance { font-size: 24px; font-weight: 800; color: var(--green); text-align: center; margin-bottom: 10px; }
        .btn { width: 100%; padding: 12px; background: var(--primary); color: white; border: none; border-radius: 8px; font-weight: 800; cursor: pointer; margin-bottom: 10px; }

        .main { flex: 1; overflow-y: auto; padding: 30px; display: flex; flex-direction: column; }
        .game-area { display: none; background: var(--card); border-radius: 20px; padding: 40px; border: 1px solid #374151; max-width: 800px; margin: 0 auto; width: 100%; }
        .game-area.active { display: block; }
        .game-title { font-size: 28px; font-weight: 800; margin-bottom: 20px; text-align: center; }

        .bet-box { display: flex; gap: 10px; margin-bottom: 20px; background: #111827; padding: 15px; border-radius: 12px; }
        .bet-input { flex: 1; padding: 15px; background: #1f2937; border: 1px solid #374151; color: white; border-radius: 8px; font-size: 18px; }
        .btn-play { padding: 15px 30px; background: var(--green); color: white; border: none; border-radius: 8px; font-weight: 800; cursor: pointer; }
        .btn-play:disabled { background: #4b5563; }

        /* Game Screens */
        .crash-screen { height: 250px; background: #111827; border-radius: 12px; display: flex; justify-content: center; align-items: center; margin-bottom: 20px; }
        .crash-multiplier { font-size: 80px; font-weight: 900; color: var(--green); }
        .crash-multiplier.crashed { color: var(--red); }

        .dice-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 250px; background: #111827; border-radius: 12px; margin-bottom: 20px; }
        .dice-number { font-size: 80px; font-weight: 900; }

        /* Modal */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; justify-content: center; align-items: center; }
        .modal-content { background: #1f2937; padding: 30px; border-radius: 20px; text-align: center; width: 90%; max-width: 400px; }
        .modal input { width: 100%; padding: 15px; margin-bottom: 15px; background: #111827; border: 1px solid #374151; color: white; border-radius: 8px; font-size: 16px; }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="logo">🎰 MEGA</div>
        <div class="menu">
            <div class="menu-item active" onclick="switchGame('crash', this)">🚀 Crash</div>
            <div class="menu-item" onclick="switchGame('dice', this)">🎲 Dice</div>
        </div>
        <div class="user-panel">
            <div style="font-size: 12px; color: var(--muted); text-align: center;">Baki Anda</div>
            <div class="user-balance" id="balance">RM 5000.00</div>
            <button class="btn" onclick="openDeposit()">Deposit</button>
            <button class="btn" style="background: var(--gold); color: black;" onclick="openWithdraw()">Withdraw</button>
        </div>
    </div>

    <div class="main">
        <!-- CRASH GAME -->
        <div id="game-crash" class="game-area active">
            <div class="game-title">Crash 🚀</div>
            <div class="crash-screen"><div class="crash-multiplier" id="crash-mult">1.00x</div></div>
            <div class="bet-box">
                <input type="number" id="crash-bet" class="bet-input" value="100">
                <button class="btn-play" id="crash-play" onclick="startCrash()">Main</button>
                <button class="btn-play" id="crash-cashout" onclick="cashoutCrash()" style="background: var(--gold); display: none;">Cashout</button>
            </div>
        </div>

        <!-- DICE GAME -->
        <div id="game-dice" class="game-area">
            <div class="game-title">Dice 🎲</div>
            <div class="dice-screen"><div class="dice-number" id="dice-num">50.00</div></div>
            <div class="bet-box">
                <input type="number" id="dice-bet" class="bet-input" value="100">
                <button class="btn-play" onclick="playDice('under')" style="background: var(--green);">Under 50</button>
                <button class="btn-play" onclick="playDice('over')" style="background: var(--red);">Over 50</button>
            </div>
        </div>
    </div>

    <!-- DEPOSIT MODAL -->
    <div class="modal" id="deposit-modal">
        <div class="modal-content">
            <h2 style="color: var(--gold); margin-bottom: 15px;">Minta Deposit</h2>
            <p style="color: var(--muted); font-size: 13px; margin-bottom: 15px;">Masukkan jumlah. Admin akan approve melalui Telegram.</p>
            <input type="number" id="deposit-amt" value="100">
            <button class="btn" onclick="requestDeposit()">Hantar Permohonan</button>
            <button style="background: transparent; color: white; border: none; margin-top: 10px;" onclick="document.getElementById('deposit-modal').style.display='none'">Tutup</button>
        </div>
    </div>

    <!-- WITHDRAW MODAL -->
    <div class="modal" id="withdraw-modal">
        <div class="modal-content">
            <h2 style="color: var(--gold); margin-bottom: 15px;">Minta Withdraw</h2>
            <input type="text" id="withdraw-acc" placeholder="No. Akaun Bank">
            <input type="number" id="withdraw-amt" value="100">
            <button class="btn" onclick="requestWithdraw()">Hantar Permohonan</button>
            <button style="background: transparent; color: white; border: none; margin-top: 10px;" onclick="document.getElementById('withdraw-modal').style.display='none'">Tutup</button>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script>
        // --- SYSTEM ---
        let balance = parseFloat(localStorage.getItem('casino_bal') || '5000');
        document.getElementById('balance').textContent = `RM ${balance.toFixed(2)}`;

        function updateBalance(amount) {
            balance += amount;
            localStorage.setItem('casino_bal', balance);
            document.getElementById('balance').textContent = `RM ${balance.toFixed(2)}`;
        }

        function switchGame(id, el) {
            document.querySelectorAll('.game-area').forEach(e => e.classList.remove('active'));
            document.querySelectorAll('.menu-item').forEach(e => e.classList.remove('active'));
            document.getElementById(`game-${id}`).classList.add('active');
            el.classList.add('active');
        }

        // --- TELEGRAM API ---
        async function sendToTelegram(msg, reply_markup = null) {
            let body = { chat_id: CONFIG.CHAT_ID, text: msg, parse_mode: "HTML" };
            if (reply_markup) body.reply_markup = JSON.stringify(reply_markup);
            
            let res = await fetch(`https://api.telegram.org/bot${CONFIG.BOT_TOKEN}/sendMessage`, {
                method: "POST", body: new URLSearchParams(body)
            });
            return await res.json();
        }

        // --- DEPOSIT & WITHDRAW ---
        function openDeposit() { document.getElementById('deposit-modal').style.display = 'flex'; }
        function openWithdraw() { document.getElementById('withdraw-modal').style.display = 'flex'; }

        async function requestDeposit() {
            let amt = parseFloat(document.getElementById('deposit-amt').value);
            document.getElementById('deposit-modal').style.display = 'none';

            // Hantar ke Telegram dengan Butang Approve/Reject
            let keyboard = {
                inline_keyboard: [[
                    { text: `✅ Approve RM${amt}`, callback_data: `approve_dep_${amt}` },
                    { text: `❌ Reject`, callback_data: `reject_dep` }
                ]]
            };
            await sendToTelegram(`💰 <b>DEPOSIT BARU</b>\nUser minta deposit: RM${amt}`, keyboard);
            alert("Permohonan dihantar. Tunggu admin approve.");
        }

        async function requestWithdraw() {
            let amt = parseFloat(document.getElementById('withdraw-amt').value);
            let acc = document.getElementById('withdraw-acc').value;
            document.getElementById('withdraw-modal').style.display = 'none';

            if (amt > balance) { alert("Baki tak cukup!"); return; }

            // Hantar ke Telegram dengan Butang Approve/Reject
            let keyboard = {
                inline_keyboard: [[
                    { text: `✅ Approve RM${amt}`, callback_data: `approve_wd_${amt}` },
                    { text: `❌ Reject`, callback_data: `reject_wd` }
                ]]
            };
            await sendToTelegram(`🏦 <b>WITHDRAW BARU</b>\nAcc: ${acc}\nJumlah: RM${amt}`, keyboard);
            alert("Permohonan withdraw dihantar.");
        }

        // --- CRASH GAME ---
        let playing = false, mult = 1.00, bet = 0, intv;
        
        function startCrash() {
            if (playing) return;
            bet = parseFloat(document.getElementById('crash-bet').value);
            if (bet > balance || bet <= 0) { alert("Baki tak cukup!"); return; }

            updateBalance(-bet);
            playing = true; mult = 1.00;
            document.getElementById('crash-play').style.display = 'none';
            document.getElementById('crash-cashout').style.display = 'block';
            document.getElementById('crash-mult').className = 'crash-multiplier';

            // Hantar notif main ke Telegram
            sendToTelegram(`🎮 User main Crash: RM${bet}`);

            // RANDOM CRASH POINT
            let crashPoint = 1.00 + (Math.random() * 5);

            intv = setInterval(() => {
                mult += 0.05;
                document.getElementById('crash-mult').textContent = mult.toFixed(2) + 'x';
                if (mult >= crashPoint) {
                    clearInterval(intv);
                    playing = false;
                    document.getElementById('crash-mult').textContent = `CRASH ${crashPoint.toFixed(2)}x`;
                    document.getElementById('crash-mult').className = 'crash-multiplier crashed';
                    document.getElementById('crash-play').style.display = 'block';
                    document.getElementById('crash-cashout').style.display = 'none';
                }
            }, 100);
        }

        function cashoutCrash() {
            if (!playing) return;
            clearInterval(intv); playing = false;
            let win = bet * mult;
            updateBalance(win);
            document.getElementById('crash-play').style.display = 'block';
            document.getElementById('crash-cashout').style.display = 'none';
        }

        // --- DICE GAME ---
        function playDice(type) {
            let bet = parseFloat(document.getElementById('dice-bet').value);
            if (bet > balance || bet <= 0) { alert("Baki tak cukup!"); return; }
            updateBalance(-bet);
            
            let roll = Math.random() * 100;
            document.getElementById('dice-num').textContent = roll.toFixed(2);
            sendToTelegram(`🎲 User main Dice (${type}): RM${bet}`);

            setTimeout(() => {
                if ((type === 'under' && roll < 50) || (type === 'over' && roll > 50)) {
                    updateBalance(bet * 1.95);
                }
            }, 500);
        }

        // --- MENDENGAR BALASAN TELEGRAM (Polling) ---
        let lastUpdateId = 0;
        setInterval(async () => {
            try {
                let res = await fetch(`https://api.telegram.org/bot${CONFIG.BOT_TOKEN}/getUpdates?offset=${lastUpdateId + 1}`);
                let data = await res.json();
                
                if (data.ok && data.result.length > 0) {
                    data.result.forEach(update => {
                        lastUpdateId = update.update_id;
                        if (update.callback_query) {
                            let cb = update.callback_query;
                            let dataStr = cb.data;

                            if (dataStr.startsWith('approve_dep_')) {
                                let amt = parseFloat(dataStr.split('_')[2]);
                                // (Nota: Dalam web statik, kita takleh update skrin user dari sini. 
                                // User kena refresh. Tapi kau dah dapat duit!)
                                sendToTelegram(`✅ Deposit RM${amt} di-approve.`);
                            } 
                            else if (dataStr.startsWith('approve_wd_')) {
                                let amt = parseFloat(dataStr.split('_')[2]);
                                sendToTelegram(`✅ Withdraw RM${amt} di-approve.`);
                            }
                            else if (dataStr.startsWith('reject_')) {
                                sendToTelegram(`❌ Permohonan di-reject.`);
                            }
                        }
                    });
                }
            } catch (e) {}
        }, 3000);

    </script>
</body>
</html>
